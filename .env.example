# Copy this file to .env and fill in the values you have.
# Everything has a sane default, so the app works out of the box with
# public, keyless endpoints (CoinGecko + RSS news).

# --- MongoDB ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB=eth_predictor

# --- Market data ---
# CoinGecko public API needs no key. Used for current price, volume, OHLC history.
COINGECKO_API_BASE=https://api.coingecko.com/api/v3
COIN_ID=ethereum
VS_CURRENCY=usd

# --- On-chain data (optional) ---
# https://etherscan.io/apis - used as a price fallback + live gas price signal.
ETHERSCAN_API_KEY=

# --- News ---
# Optional: https://cryptopanic.com/developers/api/ (leave empty to use RSS fallback only)
CRYPTOPANIC_API_KEY=
# Optional: https://newsapi.org/ (leave empty to skip)
NEWSAPI_KEY=

# --- Optional narrative summary ---
# https://console.anthropic.com/ - leave empty to skip the "why" narrative endpoint
ANTHROPIC_API_KEY=

# --- Scheduler ---
COLLECT_INTERVAL_MINUTES=15
NEWS_INTERVAL_MINUTES=5
# A full Scout AI scan trains a real model per asset across ~135 assets, so
# it runs far less often than the single-coin market/news jobs above.
SCOUT_INTERVAL_MINUTES=60

# --- Prediction ---
PREDICTION_HORIZON_HOURS=24
PREDICTION_BACKEND=sklearn
# sklearn (default, no extra deps) | prophet (needs `prophet`) | lstm (needs `tensorflow`)

# --- Flask ---
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false
